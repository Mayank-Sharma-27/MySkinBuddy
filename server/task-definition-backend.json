{
    "family": "myskinbuddy-backend",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "backend",
            "image": "117669335220.dkr.ecr.us-east-1.amazonaws.com/myskinbuddy-backend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "CORS_ORIGIN",
                    "value": "https://myglowpal.com"
                },
                {
                    "name": "ALLOWED_ORIGINS",
                    "value": "http://localhost:3000,https://myglowpal.com,https://www.myglowpal.com"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "AWS_ACCESS_KEY_ID",
                    "valueFrom": "/myskinbuddy/AWS_ACCESS_KEY_ID"
                },
                {
                    "name": "AWS_SECRET_ACCESS_KEY",
                    "valueFrom": "/myskinbuddy/AWS_SECRET_ACCESS_KEY"
                },
                {
                    "name": "TOGETHER_API_KEY",
                    "valueFrom": "/myskinbuddy/TOGETHER_API_KEY"
                },
                {
                    "name": "PINECONE_API_KEY",
                    "valueFrom": "/myskinbuddy/PINECONE_API_KEY"
                },
                {
                    "name": "OPENAI_API_KEY",
                    "valueFrom": "/myskinbuddy/OPENAI_API_KEY"
                },
                {
                    "name": "PERPLEXITY_API_KEY",
                    "valueFrom": "/myskinbuddy/PERPLEXITY_API_KEY"
                },
                {
                    "name": "GOOGLE_API_KEY",
                    "valueFrom": "/myskinbuddy/GOOGLE_API_KEY"
                },
                {
                    "name": "GOOGLE_CSE_ID",
                    "valueFrom": "/myskinbuddy/GOOGLE_CSE_ID"
                },
                {
                    "name": "GOOGLE_CLIENT_ID",
                    "valueFrom": "/myskinbuddy/GOOGLE_CLIENT_ID"
                },
                {
                    "name": "GOOGLE_CLIENT_SECRET",
                    "valueFrom": "/myskinbuddy/GOOGLE_CLIENT_SECRET"
                },
                {
                    "name": "PPLX_API_KEY",
                    "valueFrom": "/myskinbuddy/PPLX_API_KEY"
                },
                {
                    "name": "GOOGLE_VISION_CREDENTIALS",
                    "valueFrom": "/myskinbuddy/GOOGLE_VISION_CREDENTIALS"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/myskinbuddy",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "backend"
                }
            },
            "systemControls": []
        }
    ],
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::117669335220:role/MySkinBuddyECSTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::117669335220:role/MySkinBuddyECSTaskRole",
    "volumes": []
}
